[tool.cibuildwheel]
# Build only Linux manylinux_2_28 wheels for Python 3.8-3.13
only = "cp38-manylinux_x86_64 cp39-manylinux_x86_64 cp310-manylinux_x86_64 cp311-manylinux_x86_64 cp312-manylinux_x86_64 cp313-manylinux_x86_64"

# Use the manylinux_2_28 image for all builds
linux = { image = "manylinux_2_28" }

# Environment variables for the build
environment = { PYO3_USE_ABI3_FORWARD_COMPATIBILITY = "1" }

# Before build: install Rust toolchain
before-build = "curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable && source $HOME/.cargo/env"

# Build command - use python -m maturin with the correct interpreter
build = "python -m pip install maturin && python -m maturin build --release --out {dest_dir} --interpreter python"

# Only build from bindings/python directory
package-dir = "bindings/python"

# Output directory
output-dir = "wheelhouse"